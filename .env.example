# MCP 서버(.mcp.json)용 환경변수 — 이 파일을 .env로 복사해 값을 채운다. .env는 커밋하지 않는다.
# Claude Code는 .env를 자동으로 읽지 않으므로 실행 전에 셸로 내보낸다:
#   set -a; source .env; set +a; claude

# GitHub MCP — Fine-grained PAT (https://github.com/settings/personal-access-tokens/new)
# 권장: 이 리포만 선택, Contents/Issues/Pull requests/Actions 읽기 권한부터 시작
GITHUB_PAT=

# Jenkins MCP — JENKINS_PASSWORD에는 계정 비밀번호가 아니라 API 토큰을 넣는다
# (Jenkins > 사용자 > Security > API Token > Add new Token)
JENKINS_URL=https://jenkins.example.com
JENKINS_USERNAME=
JENKINS_PASSWORD=
JENKINS_USE_API_TOKEN=true
